---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import { FontWorkbench } from '../components/workbench/FontWorkbench';
import { translations } from '../i18n/translations';

const t = translations.en;
const url = 'https://fntx.modone.me/convert/';
const homeUrl = 'https://fntx.modone.me/';
const webappId = 'https://fntx.modone.me/#webapp';

const faqs = [
  {
    question: 'Does converting change how the font looks?',
    answer:
      'Usually not. Conversion changes how the file is packaged and compressed, while the letter shapes stay the same. OTF and TTF describe curves differently, so very fine details may differ slightly. Keep the original and preview the result.',
  },
  {
    question: 'Why is the WOFF2 file so much smaller than the TTF?',
    answer:
      'WOFF2 is compressed for web downloads. The glyph data is still there, just packed more tightly. Browsers unpack it automatically, so the rendering matches the original font.',
  },
  {
    question: 'Can I convert several files at once?',
    answer:
      'The tool handles one font at a time. For a batch, convert them one by one; each finished file is downloaded to your computer.',
  },
  {
    question: 'Can I convert WOFF2 back to TTF?',
    answer:
      'Yes. Open the WOFF2 file in the converter and choose TTF as the output. Repeated conversions will not restore data that was already removed.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: t.seo.convert.title,
    description: t.seo.convert.description,
    inLanguage: 'en',
    isPartOf: { '@id': 'https://fntx.modone.me/#website' },
    mainEntity: { '@id': webappId },
    breadcrumb: { '@id': `${url}#breadcrumb` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: 'Convert formats', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout
  lang="en"
  currentPath="convert"
  title={t.seo.convert.title}
  description={t.seo.convert.description}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
    <Breadcrumbs items={[{ label: t.breadcrumb.home, href: homeUrl }, { label: t.footer.links.convert }]} />

    <header class="mt-4 max-w-3xl space-y-3">
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
        TTF to WOFF2, OTF to TTF: Online Font Converter
      </h1>
      <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
        The same font can be stored in different formats. WOFF2 keeps web downloads small, while TTF
        is better for installing or editing. Drop a font, choose a target format, and the conversion
        happens right in your browser.
      </p>
    </header>

    <div class="mt-6">
      <FontWorkbench client:load lang="en" initialTab="convert" />
    </div>

    <article class="mx-auto mt-10 max-w-3xl space-y-8 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Which format should you pick?</h2>
        <ul class="list-disc space-y-1 pl-5">
          <li><strong>Websites</strong>: WOFF2 — usually the smallest download. Add WOFF only for very old browsers.</li>
          <li><strong>Desktop and apps</strong>: TTF — universal and easy to edit later.</li>
          <li><strong>Print design</strong>: OTF — common in professional design software.</li>
          <li><strong>Legacy systems</strong>: EOT or SVG — only for old projects.</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">How to convert</h2>
        <ol class="list-decimal space-y-1 pl-5">
          <li>Drop the font you want to convert.</li>
          <li>Choose a target format under “Convert to”.</li>
          <li>Click “Convert font”, check the size change and preview.</li>
          <li>Download the new file. Your original stays unchanged.</li>
        </ol>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">FAQ</h2>
        {faqs.map((faq) => (
          <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/60">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{faq.question}</h3>
            <p class="mt-1.5 text-xs">{faq.answer}</p>
          </div>
        ))}
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Related tools</h2>
        <p>
          Web font still too large? Try <a href="/subset/" class="underline hover:text-slate-900 dark:hover:text-slate-100">shrinking it first</a>.
          Working with a collection? Use{' '}
          <a href="/ttc/" class="underline hover:text-slate-900 dark:hover:text-slate-100">Collections</a>.
          For the differences between formats, see the{' '}
          <a href="/formats/" class="underline hover:text-slate-900 dark:hover:text-slate-100">font format comparison</a>.
        </p>
        <p class="text-xs text-slate-500">
          Font files carry their own licenses. Please confirm you are allowed to convert and
          redistribute a font before publishing the result.
        </p>
      </section>
    </article>

    <AdSlot lang="en" slotId="convert-bottom-en" />
  </div>
</BaseLayout>