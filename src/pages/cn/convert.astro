---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import { FontWorkbench } from '../../components/workbench/FontWorkbench';
import { translations } from '../../i18n/translations';

const t = translations.zh;
const url = 'https://fntx.modone.me/cn/convert/';
const homeUrl = 'https://fntx.modone.me/cn/';
const webappId = 'https://fntx.modone.me/cn/#webapp';

const faqs = [
  {
    question: '转换格式会让字形变样吗？',
    answer:
      '通常不会。转换主要改变文件的封装和压缩方式，字形本身保持不变。OTF 与 TTF 的曲线表达方式不同，极端细节可能有细微差别，转换前建议保留原文件并预览结果。',
  },
  {
    question: 'TTF 转 WOFF2 后为什么小了很多？',
    answer:
      'WOFF2 是专门为网页下载设计的压缩格式，字形数据仍在，只是打包得更紧。浏览器下载后会自动解开，显示效果和原字体一致。',
  },
  {
    question: '一次能转换多个文件吗？',
    answer:
      '当前一次处理一个字体。批量转换可以逐个进行，已转换的文件会直接下载到你的电脑。',
  },
  {
    question: 'WOFF2 能转回 TTF 吗？',
    answer:
      '可以。打开「格式转换」，载入 WOFF2 后选择 TTF 即可。注意：反复转换不会恢复已经被去掉的数据。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: t.seo.convert.title,
    description: t.seo.convert.description,
    inLanguage: 'zh-CN',
    isPartOf: { '@id': 'https://fntx.modone.me/#website' },
    mainEntity: { '@id': webappId },
    breadcrumb: { '@id': `${url}#breadcrumb` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: '格式转换', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout
  lang="zh"
  currentPath="convert"
  title={t.seo.convert.title}
  description={t.seo.convert.description}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
    <Breadcrumbs items={[{ label: t.breadcrumb.home, href: homeUrl }, { label: t.footer.links.convert }]} />

    <header class="mt-4 max-w-3xl space-y-3">
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
        TTF 转 WOFF2、OTF 转 TTF：在线格式转换
      </h1>
      <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
        同一个字体可以存成不同格式。做网页时 WOFF2 体积最小，装到电脑或 App 里则用 TTF。拖入字体，选好目标格式，转换立刻在你的浏览器里完成。
      </p>
    </header>

    <div class="mt-6">
      <FontWorkbench client:load lang="zh" initialTab="convert" />
    </div>

    <article class="mx-auto mt-10 max-w-3xl space-y-8 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">该转成什么格式？</h2>
        <ul class="list-disc space-y-1 pl-5">
          <li><strong>网页</strong>：WOFF2，下载体积通常最小；需要兼容很老的浏览器时再加 WOFF。</li>
          <li><strong>装到电脑、放进 App</strong>：TTF，通用且方便继续编辑。</li>
          <li><strong>印刷设计</strong>：OTF，专业设计软件更常用。</li>
          <li><strong>遗留系统</strong>：EOT 或 SVG，只有很老的项目才需要。</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">操作步骤</h2>
        <ol class="list-decimal space-y-1 pl-5">
          <li>拖入要转换的字体文件。</li>
          <li>在「想换成」里选择目标格式。</li>
          <li>点「开始转换」，查看体积变化并预览。</li>
          <li>下载新字体。原文件不会被修改。</li>
        </ol>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">常见问题</h2>
        {faqs.map((faq) => (
          <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/60">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{faq.question}</h3>
            <p class="mt-1.5 text-xs">{faq.answer}</p>
          </div>
        ))}
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">相关工具</h2>
        <p>
          网页字体太大？先试试
          <a href="/cn/subset/" class="underline hover:text-slate-900 dark:hover:text-slate-100">字体瘦身</a>。
          要拆开或打包字体合集？用
          <a href="/cn/ttc/" class="underline hover:text-slate-900 dark:hover:text-slate-100">字体合集</a>。
          各格式的差别可以看
          <a href="/cn/formats/" class="underline hover:text-slate-900 dark:hover:text-slate-100">字体格式对比</a>。
        </p>
        <p class="text-xs text-slate-500">
          字体文件自带授权条款。转换和再分发之前，请先确认你有相应使用权。
        </p>
      </section>
    </article>

    <AdSlot lang="zh" slotId="convert-bottom" />
  </div>
</BaseLayout>