---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import { FontWorkbench } from '../../components/workbench/FontWorkbench';
import { translations } from '../../i18n/translations';

const t = translations.zh;
const url = 'https://fntx.modone.me/cn/subset/';
const homeUrl = 'https://fntx.modone.me/cn/';
const webappId = 'https://fntx.modone.me/cn/#webapp';

const faqs = [
  {
    question: '字体瘦身会改变字形吗？',
    answer:
      '不会。瘦身只是把没用到的字去掉，保留下来的字仍使用原来的字形。建议下载后先预览，确认效果再上线。',
  },
  {
    question: '瘦身后能小多少？',
    answer:
      '取决于保留多少字。只保留一页用到的文字时，几十 MB 的中文字体通常会降到几十 KB。',
  },
  {
    question: '生僻字不在主字体里怎么办？',
    answer:
      '在「高级选项」里添加包含生僻字的字库，并设置它负责的范围（例如 20000–2FFFF），工具会把两个字库合并成一份结果。',
  },
  {
    question: '需要把整个网页的文字都粘贴进来吗？',
    answer:
      '只需要页面实际会显示的文字，例如标题、按钮、导航和正文。动态生成的内容要提前算进去，否则那些字可能不在新字体里。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: t.seo.subset.title,
    description: t.seo.subset.description,
    inLanguage: 'zh-CN',
    isPartOf: { '@id': 'https://fntx.modone.me/#website' },
    mainEntity: { '@id': webappId },
    breadcrumb: { '@id': `${url}#breadcrumb` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: '字体瘦身', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout
  lang="zh"
  currentPath="subset"
  title={t.seo.subset.title}
  description={t.seo.subset.description}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
    <Breadcrumbs items={[{ label: t.breadcrumb.home, href: homeUrl }, { label: t.footer.links.subset }]} />

    <header class="mt-4 max-w-3xl space-y-3">
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
        CJK 字体子集化：只保留网页用到的字
      </h1>
      <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
        中文字库动辄几十 MB，但一个网页通常只用几百个字。把用到的字粘贴进来，工具会生成一个只包含这些字的新字体，网页加载更快，文件也不出你的电脑。
      </p>
    </header>

    <div class="mt-6">
      <FontWorkbench client:load lang="zh" initialTab="subset" />
    </div>

    <article class="mx-auto mt-10 max-w-3xl space-y-8 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">什么时候适合用</h2>
        <ul class="list-disc space-y-1 pl-5">
          <li>网页加载中文字体很慢，希望只下载实际用到的字。</li>
          <li>只把品牌字体或标题字体放到网上，不需要完整字库。</li>
          <li>想把字体放进 App 或电子书，希望安装包更小。</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">操作步骤</h2>
        <ol class="list-decimal space-y-1 pl-5">
          <li>把 TTF、OTF、WOFF、WOFF2 或字体合集拖进上方工作台。</li>
          <li>在「要保留的文字」里粘贴网页会用到的文字。</li>
          <li>输出格式选 WOFF2（网页首选），也可以同时勾选 TTF。</li>
          <li>点「开始瘦身」，预览满意后下载。</li>
        </ol>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">常见问题</h2>
        {faqs.map((faq) => (
          <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/60">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{faq.question}</h3>
            <p class="mt-1.5 text-xs">{faq.answer}</p>
          </div>
        ))}
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">相关工具</h2>
        <p>
          瘦身之后需要换格式？用
          <a href="/cn/convert/" class="underline hover:text-slate-900 dark:hover:text-slate-100">格式转换</a>。
          手上是字体合集？先到
          <a href="/cn/ttc/" class="underline hover:text-slate-900 dark:hover:text-slate-100">字体合集</a>拆开。
          不确定格式怎么选？看
          <a href="/cn/formats/" class="underline hover:text-slate-900 dark:hover:text-slate-100">字体格式对比</a>。
        </p>
        <p class="text-xs text-slate-500">
          字体文件自带授权条款。瘦身和再分发之前，请先确认你有相应使用权。
        </p>
      </section>
    </article>

    <AdSlot lang="zh" slotId="subset-bottom" />
  </div>
</BaseLayout>