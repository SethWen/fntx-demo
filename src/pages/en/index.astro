---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { FontWorkbench } from '../../components/workbench/FontWorkbench';
import { translations } from '../../i18n/translations';

const lang = 'en';
const t = translations[lang];
---

<BaseLayout
  lang={lang}
  currentPath="workbench"
  title={`${t.siteName} - ${t.tagline}`}
  description={t.hero.subtitle}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <div class="mx-auto mb-7 flex max-w-5xl flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
          {t.hero.title}
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {t.hero.subtitle}
        </p>
      </div>
      <div class="flex flex-wrap gap-1.5 font-mono text-[11px] text-slate-600 dark:text-violet-200/80">
        <span class="qv-glass-card rounded-md border border-violet-950/10 px-2.5 py-1 dark:border-violet-400/20">TTF</span>
        <span class="qv-glass-card rounded-md border border-violet-950/10 px-2.5 py-1 dark:border-violet-400/20">OTF</span>
        <span class="qv-glass-card rounded-md border border-violet-950/10 px-2.5 py-1 dark:border-violet-400/20">WOFF</span>
        <span class="qv-glass-card rounded-md border border-violet-950/10 px-2.5 py-1 dark:border-violet-400/20">WOFF2</span>
        <span class="qv-glass-card rounded-md border border-violet-950/10 px-2.5 py-1 dark:border-violet-400/20">TTC</span>
      </div>
    </div>

    <FontWorkbench client:load lang={lang} />

    <AdSlot lang={lang} slotId="home-bottom-en" />

    <section class="mx-auto mt-10 grid max-w-5xl gap-4 sm:grid-cols-3">
      <div class="qv-glass-card rounded-2xl border border-violet-950/10 p-5 dark:border-violet-400/15">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Multi-Source Subsetting</h2>
        <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          Subset and merge BMP & SIP supplementary fonts by Unicode range in a single pass with missing codepoint reports.
        </p>
      </div>
      <div class="qv-glass-card rounded-2xl border border-violet-950/10 p-5 dark:border-violet-400/15">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Full Format Conversion</h2>
        <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          Convert locally between TTF, WOFF2, WOFF, OTF (quadratic to cubic CFF), EOT, and SVG without uploading files.
        </p>
      </div>
      <div class="qv-glass-card rounded-2xl border border-violet-950/10 p-5 dark:border-violet-400/15">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">TTC Pack & Unpack</h2>
        <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          Inspect shared table stats in TrueType Collections, extract individual faces, or pack multiple fonts with deduplication.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
