---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { FontWorkbench } from '../components/workbench/FontWorkbench';
import { translations } from '../i18n/translations';

const lang = 'zh';
const t = translations[lang];
---

<BaseLayout
  lang={lang}
  currentPath="workbench"
  title={`${t.siteName} - ${t.tagline}`}
  description={t.hero.subtitle}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <div class="mx-auto mb-8 max-w-3xl text-center">
      <span class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700 dark:border-indigo-900/60 dark:bg-indigo-950/60 dark:text-indigo-300">
        {t.hero.badge}
      </span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        {t.hero.title}
      </h1>
      <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base dark:text-slate-400">
        {t.hero.subtitle}
      </p>
    </div>

    <FontWorkbench client:load lang={lang} />

    <AdSlot lang={lang} slotId="home-bottom" />

    <section class="mx-auto mt-10 grid max-w-5xl gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-5 dark:border-slate-800 dark:bg-slate-900/50">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">多源子集化与合并</h2>
        <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          支持 BMP 基本区与 SIP 扩展区字库按 Unicode 区间独立裁剪并自动合并，精确统计缺失码点。
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-5 dark:border-slate-800 dark:bg-slate-900/50">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">全格式本地互转</h2>
        <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          支持 TTF、WOFF2、WOFF、OTF（TrueType 提升为 CFF 三次贝塞尔）、EOT 与 SVG 一键转换。
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-5 dark:border-slate-800 dark:bg-slate-900/50">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">TTC 集合无损拆装</h2>
        <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          可视化查看 TTC 容器表共享统计，支持单字形或全量拆解为独立 SFNT，以及多字体表去重打包。
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
