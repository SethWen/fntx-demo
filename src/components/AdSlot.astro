---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
  slotId?: string;
  className?: string;
}

const { lang, slotId = 'default-slot', className = '' } = Astro.props;
const t = translations[lang];
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---

{
  adsenseClient && (
    <aside
      aria-label={t.ad.label}
      class={`mx-auto my-6 max-w-5xl rounded-xl border border-slate-200/80 bg-white/60 p-3 text-center dark:border-slate-800 dark:bg-slate-900/50 ${className}`}
    >
      <div class="mb-1 text-[11px] uppercase tracking-wider text-slate-400">{t.ad.label}</div>
      <ins
        class="adsbygoogle block"
        style="display:block"
        data-ad-client={adsenseClient}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch {}
      </script>
    </aside>
  )
}
