---
import '../styles/global.css';
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  currentPath: 'workbench' | 'formats' | 'guide' | 'privacy';
}

const { lang, title, description, currentPath } = Astro.props;
const t = translations[lang];
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;

const routeMap: Record<Props['currentPath'], { zh: string; en: string }> = {
  workbench: { zh: '/', en: '/en/' },
  formats: { zh: '/formats', en: '/en/formats' },
  guide: { zh: '/guide', en: '/en/guide' },
  privacy: { zh: '/privacy', en: '/en/privacy' },
};

const targetLang: Lang = lang === 'zh' ? 'en' : 'zh';
const switchHref = routeMap[currentPath][targetLang];
const navItems: Array<{ key: Props['currentPath']; label: string; href: string }> = [
  { key: 'workbench', label: t.nav.workbench, href: routeMap.workbench[lang] },
  { key: 'formats', label: t.nav.formats, href: routeMap.formats[lang] },
  { key: 'guide', label: t.nav.guide, href: routeMap.guide[lang] },
  { key: 'privacy', label: t.nav.privacy, href: routeMap.privacy[lang] },
];
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="zh-CN" href={routeMap[currentPath].zh} />
    <link rel="alternate" hreflang="en" href={routeMap[currentPath].en} />

    <!-- Prevent theme flash (FOUC) before first paint -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('fntx-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = saved ? saved === 'dark' : prefersDark;
          document.documentElement.classList.toggle('dark', isDark);
        } catch {}
      })();
    </script>

    {
      adsenseClient && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/85 backdrop-blur dark:border-slate-800/80 dark:bg-slate-950/85">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
        <a href={routeMap.workbench[lang]} class="flex items-center gap-2.5 font-semibold tracking-tight">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white shadow-sm">
            fx
          </span>
          <span class="text-lg">{t.siteName}</span>
        </a>

        <nav class="hidden items-center gap-6 text-sm font-medium md:flex">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={
                  currentPath === item.key
                    ? 'text-indigo-600 dark:text-indigo-400'
                    : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100'
                }
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-2">
          <a
            href={switchHref}
            data-lang-switch={targetLang}
            class="rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            {t.nav.switchLang}
          </a>

          <button
            id="theme-toggle-btn"
            type="button"
            aria-label={t.nav.themeToggle}
            title={t.nav.themeToggle}
            class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <svg class="block h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile compact nav -->
      <div class="flex items-center justify-center gap-4 border-t border-slate-200/60 px-4 py-2 text-xs font-medium md:hidden dark:border-slate-800/60">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={
                currentPath === item.key
                  ? 'text-indigo-600 dark:text-indigo-400'
                  : 'text-slate-600 dark:text-slate-400'
              }
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200/80 bg-white/60 py-6 text-center text-xs text-slate-500 dark:border-slate-800/80 dark:bg-slate-950/60 dark:text-slate-400">
      <div class="mx-auto max-w-6xl space-y-2 px-4">
        <p>{t.footer.localOnly}</p>
        <p class="flex items-center justify-center gap-3">
          <span>{t.footer.copyright}</span>
          <span>·</span>
          <a href={routeMap.privacy[lang]} class="underline hover:text-slate-700 dark:hover:text-slate-200">
            {t.nav.privacy}
          </a>
        </p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle-btn');
        if (btn) {
          btn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            try {
              localStorage.setItem('fntx-theme', isDark ? 'dark' : 'light');
            } catch {}
          });
        }
        document.querySelectorAll('[data-lang-switch]').forEach((el) => {
          el.addEventListener('click', () => {
            const target = el.getAttribute('data-lang-switch');
            if (target) {
              try {
                localStorage.setItem('fntx-lang', target);
              } catch {}
            }
          });
        });
      })();
    </script>
  </body>
</html>
