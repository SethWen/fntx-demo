---
import '../styles/global.css';
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  currentPath: 'workbench' | 'formats' | 'guide' | 'privacy';
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { lang, title, description, currentPath, jsonLd } = Astro.props;
const t = translations[lang];
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;

const routeMap: Record<Props['currentPath'], { zh: string; en: string }> = {
  workbench: { zh: '/', en: '/en/' },
  formats: { zh: '/formats/', en: '/en/formats/' },
  guide: { zh: '/guide/', en: '/en/guide/' },
  privacy: { zh: '/privacy/', en: '/en/privacy/' },
};

const siteBase = Astro.site ?? new URL('https://fntx.modone.me');
const zhUrl = new URL(routeMap[currentPath].zh, siteBase).href;
const enUrl = new URL(routeMap[currentPath].en, siteBase).href;
const canonicalUrl = lang === 'zh' ? zhUrl : enUrl;

const targetLang: Lang = lang === 'zh' ? 'en' : 'zh';
const switchHref = routeMap[currentPath][targetLang];
const navItems: Array<{ key: Props['currentPath']; label: string; href: string }> = [
  { key: 'workbench', label: t.nav.workbench, href: routeMap.workbench[lang] },
  { key: 'formats', label: t.nav.formats, href: routeMap.formats[lang] },
  { key: 'guide', label: t.nav.guide, href: routeMap.guide[lang] },
  { key: 'privacy', label: t.nav.privacy, href: routeMap.privacy[lang] },
];
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph / Twitter Card -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Prevent theme flash (FOUC) before first paint -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('fntx-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = saved ? saved === 'dark' : prefersDark;
          document.documentElement.classList.toggle('dark', isDark);
        } catch {}
      })();
    </script>

    {
      adsenseClient && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="qv-ambient" aria-hidden="true"></div>
    <header class="sticky top-0 z-30 border-b border-violet-950/10 bg-white/35 backdrop-blur-xl backdrop-saturate-150 dark:border-violet-400/15 dark:bg-[#0d0b1a]/35">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
        <a href={routeMap.workbench[lang]} class="flex items-center gap-2.5 font-semibold tracking-tight">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" class="h-8 w-8 shrink-0" fill="none" aria-hidden="true">
            <defs>
              <linearGradient id="nav-bg-violet" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#0D0B1A" />
                <stop offset="100%" stop-color="#1E1B4B" />
              </linearGradient>
              <radialGradient id="nav-sheen-violet" cx="0.25" cy="0.15" r="0.85">
                <stop offset="0%" stop-color="#A78BFA" stop-opacity="0.30" />
                <stop offset="100%" stop-color="#0D0B1A" stop-opacity="0" />
              </radialGradient>
              <linearGradient id="nav-prism-top" x1="14" y1="14" x2="50" y2="34" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#DDD6FE" />
                <stop offset="100%" stop-color="#7C3AED" />
              </linearGradient>
              <linearGradient id="nav-prism-mid" x1="18" y1="26" x2="48" y2="48" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#818CF8" stop-opacity="0.95" />
                <stop offset="100%" stop-color="#4F46E5" stop-opacity="0.75" />
              </linearGradient>
              <linearGradient id="nav-spark-cyan" x1="36" y1="32" x2="50" y2="50" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#38BDF8" />
                <stop offset="100%" stop-color="#6366F1" />
              </linearGradient>
            </defs>
            <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#nav-bg-violet)" />
            <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#nav-sheen-violet)" />
            <rect x="2.75" y="2.75" width="58.5" height="58.5" rx="15.25" stroke="#C4B5FD" stroke-opacity="0.32" stroke-width="1.5" />
            <path d="M18 19L34 13L48 19L32 25L18 19Z" fill="url(#nav-prism-top)" />
            <path d="M18 23L27 26.8V49L18 45.2V23Z" fill="url(#nav-prism-mid)" />
            <path d="M27 31L42 25.5V32.5L27 38V31Z" fill="#A78BFA" fill-opacity="0.72" />
            <path d="M35 37L46 48M46 37L35 48" stroke="url(#nav-spark-cyan)" stroke-width="4.5" stroke-linecap="round" />
          </svg>
          <span class="text-lg">{t.siteName}</span>
          <span class="rounded-md border border-violet-950/10 bg-violet-500/10 px-1.5 py-0.5 font-mono text-[10px] font-medium text-violet-700 dark:border-violet-400/20 dark:bg-violet-400/10 dark:text-violet-300">
            wasm
          </span>
        </a>

        <nav class="hidden items-center gap-6 text-sm font-medium md:flex">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={
                  currentPath === item.key
                    ? 'text-violet-600 dark:text-violet-300'
                    : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100'
                }
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-2">
          <a
            href={switchHref}
            data-lang-switch={targetLang}
            class="rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            {t.nav.switchLang}
          </a>

          <button
            id="theme-toggle-btn"
            type="button"
            aria-label={t.nav.themeToggle}
            title={t.nav.themeToggle}
            class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <svg class="block h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile compact nav -->
      <div class="flex items-center justify-center gap-4 border-t border-violet-950/10 px-4 py-2 text-xs font-medium md:hidden dark:border-violet-400/15">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={
                currentPath === item.key
                  ? 'text-violet-600 dark:text-violet-300'
                  : 'text-slate-600 dark:text-slate-400'
              }
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-violet-950/10 bg-white/45 py-6 text-center text-xs text-slate-500 backdrop-blur-md dark:border-violet-400/15 dark:bg-[#0b0a14]/55 dark:text-slate-400">
      <div class="mx-auto max-w-6xl space-y-2 px-4">
        <p>{t.footer.localOnly}</p>
        <p class="flex items-center justify-center gap-3">
          <span>{t.footer.copyright}</span>
          <span>·</span>
          <a href={routeMap.privacy[lang]} class="underline hover:text-slate-700 dark:hover:text-slate-200">
            {t.nav.privacy}
          </a>
        </p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle-btn');
        if (btn) {
          btn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            try {
              localStorage.setItem('fntx-theme', isDark ? 'dark' : 'light');
            } catch {}
          });
        }
        document.querySelectorAll('[data-lang-switch]').forEach((el) => {
          el.addEventListener('click', () => {
            const target = el.getAttribute('data-lang-switch');
            if (target) {
              try {
                localStorage.setItem('fntx-lang', target);
              } catch {}
            }
          });
        });
      })();
    </script>
  </body>
</html>
