---
import "../styles/global.css";
import { translations, type Lang } from "../i18n/translations";

type PageKey =
  | "workbench"
  | "formats"
  | "guide"
  | "privacy"
  | "subset"
  | "convert"
  | "ttc"
  | "glossary"
  | "about";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  currentPath?: PageKey;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  currentPath,
  jsonLd,
  noindex = false,
} = Astro.props;
const t = translations[lang];
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL;

const routeMap: Record<PageKey, { zh: string; en: string }> = {
  workbench: { en: "/", zh: "/cn/" },
  subset: { en: "/subset/", zh: "/cn/subset/" },
  convert: { en: "/convert/", zh: "/cn/convert/" },
  ttc: { en: "/ttc/", zh: "/cn/ttc/" },
  formats: { en: "/formats/", zh: "/cn/formats/" },
  guide: { en: "/guide/", zh: "/cn/guide/" },
  glossary: { en: "/glossary/", zh: "/cn/glossary/" },
  about: { en: "/about/", zh: "/cn/about/" },
  privacy: { en: "/privacy/", zh: "/cn/privacy/" },
};

const siteBase = Astro.site ?? new URL("https://fntx.modone.me");
const currentRoute = currentPath ? routeMap[currentPath] : null;
const canonicalUrl = currentRoute
  ? new URL(currentRoute[lang], siteBase).href
  : null;
const ogImage = new URL(`og/${lang === "zh" ? "zh" : "en"}.png`, siteBase).href;

const orgId = new URL("/#organization", siteBase).href;
const websiteId = new URL("/#website", siteBase).href;
const siteJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": orgId,
    name: t.siteName,
    url: siteBase.href,
    logo: new URL("/favicon.svg", siteBase).href,
    ...(githubUrl ? { sameAs: [githubUrl] } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": websiteId,
    name: t.siteName,
    url: siteBase.href,
    inLanguage: ["en", "zh-CN"],
    publisher: { "@id": orgId },
  },
];

const targetLang: Lang = lang === "zh" ? "en" : "zh";
const switchHref = currentRoute
  ? currentRoute[targetLang]
  : routeMap.workbench[targetLang];
const activeKey: PageKey | undefined =
  currentPath === "subset" || currentPath === "convert" || currentPath === "ttc"
    ? "workbench"
    : currentPath;
const navItems: Array<{
  key: PageKey;
  label: string;
  href: string;
}> = [
  { key: "workbench", label: t.nav.workbench, href: routeMap.workbench[lang] },
  { key: "formats", label: t.nav.formats, href: routeMap.formats[lang] },
  { key: "guide", label: t.nav.guide, href: routeMap.guide[lang] },
  { key: "privacy", label: t.nav.privacy, href: routeMap.privacy[lang] },
];

const footerGroups: Array<{
  title: string;
  links: Array<{ label: string; href: string; external?: boolean }>;
}> = [
  {
    title: t.footer.groups.tools,
    links: [
      { label: t.footer.links.home, href: routeMap.workbench[lang] },
      { label: t.footer.links.subset, href: routeMap.subset[lang] },
      { label: t.footer.links.convert, href: routeMap.convert[lang] },
      { label: t.footer.links.ttc, href: routeMap.ttc[lang] },
    ],
  },
  {
    title: t.footer.groups.learn,
    links: [
      { label: t.footer.links.formats, href: routeMap.formats[lang] },
      { label: t.footer.links.guide, href: routeMap.guide[lang] },
      { label: t.footer.links.glossary, href: routeMap.glossary[lang] },
    ],
  },
  {
    title: t.footer.groups.about,
    links: [
      { label: t.footer.links.about, href: routeMap.about[lang] },
      { label: t.footer.links.privacy, href: routeMap.privacy[lang] },
      ...(githubUrl
        ? [{ label: "GitHub", href: githubUrl, external: true }]
        : []),
    ],
  },
];
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {currentRoute && (
      <>
        <link
          rel="alternate"
          hreflang="zh-CN"
          href={new URL(currentRoute.zh, siteBase).href}
        />
        <link
          rel="alternate"
          hreflang="en"
          href={new URL(currentRoute.en, siteBase).href}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(currentRoute.en, siteBase).href}
        />
      </>
    )}

    <!-- Open Graph / Twitter Card -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl ?? siteBase.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "zh" ? "en_US" : "zh_CN"}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta
      name="google-site-verification"
      content="bvT6kBzaM-LHBnszXRegq4CERCyTFi8YoQ9coCT-tPc"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(siteJsonLd)}
    />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Prevent theme flash (FOUC) before first paint -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("fntx-theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          const isDark = saved ? saved === "dark" : prefersDark;
          document.documentElement.classList.toggle("dark", isDark);
        } catch {}
      })();
    </script>

    {adsenseClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="qv-ambient" aria-hidden="true"></div>
    <header class="sticky top-0 z-30 border-b border-violet-950/10 bg-white/35 backdrop-blur-xl backdrop-saturate-150 dark:border-violet-400/15 dark:bg-[#0d0b1a]/35">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
        <a
          href={routeMap.workbench[lang]}
          class="flex items-center gap-2.5 font-semibold tracking-tight"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 64 64"
            class="h-8 w-8 shrink-0"
            fill="none"
            aria-hidden="true"
          >
            <defs>
              <linearGradient
                id="nav-bg-violet"
                x1="0"
                y1="0"
                x2="64"
                y2="64"
                gradientUnits="userSpaceOnUse"
              >
                <stop offset="0%" stop-color="#0D0B1A" />
                <stop offset="100%" stop-color="#1E1B4B" />
              </linearGradient>
              <radialGradient
                id="nav-sheen-violet"
                cx="0.25"
                cy="0.15"
                r="0.85"
              >
                <stop offset="0%" stop-color="#A78BFA" stop-opacity="0.30" />
                <stop offset="100%" stop-color="#0D0B1A" stop-opacity="0" />
              </radialGradient>
              <linearGradient
                id="nav-prism-top"
                x1="14"
                y1="14"
                x2="50"
                y2="34"
                gradientUnits="userSpaceOnUse"
              >
                <stop offset="0%" stop-color="#DDD6FE" />
                <stop offset="100%" stop-color="#7C3AED" />
              </linearGradient>
              <linearGradient
                id="nav-prism-mid"
                x1="18"
                y1="26"
                x2="48"
                y2="48"
                gradientUnits="userSpaceOnUse"
              >
                <stop offset="0%" stop-color="#818CF8" stop-opacity="0.95" />
                <stop offset="100%" stop-color="#4F46E5" stop-opacity="0.75" />
              </linearGradient>
              <linearGradient
                id="nav-spark-cyan"
                x1="36"
                y1="32"
                x2="50"
                y2="50"
                gradientUnits="userSpaceOnUse"
              >
                <stop offset="0%" stop-color="#38BDF8" />
                <stop offset="100%" stop-color="#6366F1" />
              </linearGradient>
            </defs>
            <rect
              x="2"
              y="2"
              width="60"
              height="60"
              rx="16"
              fill="url(#nav-bg-violet)"
            />
            <rect
              x="2"
              y="2"
              width="60"
              height="60"
              rx="16"
              fill="url(#nav-sheen-violet)"
            />
            <rect
              x="2.75"
              y="2.75"
              width="58.5"
              height="58.5"
              rx="15.25"
              stroke="#C4B5FD"
              stroke-opacity="0.32"
              stroke-width="1.5"
            />
            <path
              d="M18 19L34 13L48 19L32 25L18 19Z"
              fill="url(#nav-prism-top)"
            />
            <path
              d="M18 23L27 26.8V49L18 45.2V23Z"
              fill="url(#nav-prism-mid)"
            />
            <path
              d="M27 31L42 25.5V32.5L27 38V31Z"
              fill="#A78BFA"
              fill-opacity="0.72"
            />
            <path
              d="M35 37L46 48M46 37L35 48"
              stroke="url(#nav-spark-cyan)"
              stroke-width="4.5"
              stroke-linecap="round"
            />
          </svg>
          <span class="text-lg">{t.siteName}</span>
          <span class="rounded-md border border-violet-950/10 bg-violet-500/10 px-1.5 py-0.5 font-mono text-[10px] font-medium text-violet-700 dark:border-violet-400/20 dark:bg-violet-400/10 dark:text-violet-300">
            {t.siteBadge}
          </span>
        </a>

        <nav class="hidden items-center gap-6 text-sm font-medium md:flex">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={
                activeKey === item.key
                  ? "text-violet-600 dark:text-violet-300"
                  : "text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
              }
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          <a
            href={switchHref}
            data-lang-switch={targetLang}
            class="rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            {t.nav.switchLang}
          </a>

          {
            githubUrl && (
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                title="GitHub"
                class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
                </svg>
              </a>
            )
          }

          <button
            id="theme-toggle-btn"
            type="button"
            aria-label={t.nav.themeToggle}
            title={t.nav.themeToggle}
            class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            <svg
              class="hidden h-4 w-4 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <svg
              class="block h-4 w-4 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile compact nav -->
      <div class="flex items-center justify-center gap-4 border-t border-violet-950/10 px-4 py-2 text-xs font-medium md:hidden dark:border-violet-400/15">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={
              activeKey === item.key
                ? "text-violet-600 dark:text-violet-300"
                : "text-slate-600 dark:text-slate-400"
            }
          >
            {item.label}
          </a>
        ))}
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-violet-950/10 bg-white/45 py-8 text-xs text-slate-500 backdrop-blur-md dark:border-violet-400/15 dark:bg-[#0b0a14]/55 dark:text-slate-400">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="grid gap-6 sm:grid-cols-3">
          {footerGroups.map((group) => (
            <div>
              <div class="mb-2 font-semibold text-slate-700 dark:text-slate-200">
                {group.title}
              </div>
              <ul class="space-y-1.5">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      {...(link.external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                      class="hover:text-slate-700 dark:hover:text-slate-200"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="mt-8 flex flex-col items-center gap-1.5 border-t border-violet-950/10 pt-4 text-center dark:border-violet-400/15">
          <p>{t.footer.localOnly}</p>
          <p class="flex items-center justify-center gap-3">
            <span>{t.footer.copyright}</span>
            <span>·</span>
            <a
              href={routeMap.privacy[lang]}
              class="underline hover:text-slate-700 dark:hover:text-slate-200"
            >
              {t.nav.privacy}
            </a>
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById("theme-toggle-btn");
        if (btn) {
          btn.addEventListener("click", () => {
            const isDark = document.documentElement.classList.toggle("dark");
            try {
              localStorage.setItem("fntx-theme", isDark ? "dark" : "light");
            } catch {}
          });
        }
        document.querySelectorAll("[data-lang-switch]").forEach((el) => {
          el.addEventListener("click", () => {
            const target = el.getAttribute("data-lang-switch");
            if (target) {
              try {
                localStorage.setItem("fntx-lang", target);
              } catch {}
            }
          });
        });
      })();
    </script>
  </body>
</html>
